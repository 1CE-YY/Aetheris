export const serverMenus = useStorage<Menu[]>('serverMenus', [])
const serverRoutes = useStorage<Route[]>('serverRoutes', [])
addServerRoutes(serverRoutes.value)

export function addServerRoutes(routeList: Route[]) {
  for (const r of routeList) {
    if (r.parentName) {
      router.addRoute(r.parentName, {
        path: r.path,
        component: () => import(r.component),
        name: r.name
      })
    }
  }
  serverRoutes.value = routeList
}

export function resetRoutes() {
  for (const r of clientRoutes) {
    router.addRoute(r)
  }
  serverRoutes.value = null
  serverMenus.value = null
}

export default router
本文件重要的函数及变量addServerRoutes 函数向路由表中添加由服务器提供的路由，路由分成两部分clientRoutes 这是客户端固定的路由serverRoutes 这是服务器变化的路由，存储于 localStorageresetRoutes 函数用来将路由重置为 clientRoutesvue-router@4 中的 addRoute 方法会【覆盖】同名路由，这是这种实现的关键因此，服务器返回的路由最好是 main 的子路由，这样重置时就会比较简单，用之前的 main 一覆盖就完事了serverMenus 变量记录服务器变化的菜单，存储于 localStorage(String), 四. Vue 3>3. Vue 进阶>2) vue-router>动态路由与菜单>路由文件(String), null, null, 四. Vue 3>3. Vue 进阶>2) vue-router>动态路由与菜单>路由文件(String), 85e624f8e1fcb054997275d39436581ff44c80259f2452a2af4078a0d95c8be8(String), false(Boolean), 2026-01-14 14:47:46.240874(Timestamp), 9(Long), 83(Integer), 务器变化的路由，存储于 localStorageresetRoutes 函数用来将路由重置为 clientRoutesvue-router@4 中的 addRoute 方法会【覆盖】同名路由，这是这种实现的关键因此，服务器返回的路由最好是 main 的子路由，这样重置时就会比较简单，用之前的 main 一覆盖就完事了serverMenus 变量记录服务器变化的菜单，存储于 localStorageaddServerRoutes 函数向路由表中添加由服务器提供的路由，路由分成两部分clientRoutes 这是客户端固定的路由serverRoutes 这是服务器变化的路由，存储于 localStorageclientRoutes 这是客户端固定的路由serverRoutes 这是服务器变化的路由，存储于 localStorageresetRoutes 函数用来将路由重置为 clientRoutesvue-router@4 中的 addRoute 方法会【覆盖】同名路由，这是这种实现的关键因此，服务器返回的路由最好是 main 的子路由，这样重置时就会比较简单，用之前的 main 一覆盖就完事了vue-router@4 中的 addRoute 方法会【覆盖】同名路由，这是这种实现的关键因此，服务器返回的路由最好是 main 的子路由，这样重置时就会比较简单，用之前的 main 一覆盖就完事了serverMenus 变量记录服务器变化的菜单，存储于 localStorage登录组件动态路由应当在登录时生成，A6Login.vue(String), 四. Vue 3>3. Vue 进阶>2) vue-router>动态路由与菜单>登录组件(String), null, null, 四. Vue 3>3. Vue 进阶>2) vue-router>动态路由与菜单>登录组件(String), 742a5b6e9514cecf45af1b0d44f148358d2d1d64d23209b18183c0fb4a49dd36(String), false(Boolean), 2026-01-14 14:47:46.240874(Timestamp), 9(Long), 84(Integer), 由，这样重置时就会比较简单，用之前的 main 一覆盖就完事了vue-router@4 中的 addRoute 方法会【覆盖】同名路由，这是这种实现的关键因此，服务器返回的路由最好是 main 的子路由，这样重置时就会比较简单，用之前的 main 一覆盖就完事了serverMenus 变量记录服务器变化的菜单，存储于 localStorage登录组件动态路由应当在登录时生成，A6Login.vue<template>
