如果函数外层引用的是 var 变量，外层普通的 {} 不会视为边界var x = 10; 
if(true) {
    var y = 20;
    function b() {
        console.log(x,y);
    }
    console.dir(b);
}
如果 var 变量出现了重名，则他俩会被视为同一作用域中的同一个变量var e = 10; 
if(true) {
    var e = 20;
    console.log(e);	// 打印 20
}
console.log(e);		// 因为是同一个变量，还是打印 20
如果是 let，则视为两个作用域中的两个变量let e = 10; 
if(true) {
    let e = 20;	
    console.log(e);	// 打印 20
